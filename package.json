{
  "name": "shulker-panel",
  "displayName": "Shulker Panel",
  "description": "ShulkerRDK 项目任务面板与命令快捷操作| ShulkerRDK Project Task Panel and Command Shortcuts",
  "version": "1.1.0",
  "publisher": "ChouChiu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChouChiu/Shulker-Panel"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "shulkerrdk",
    "minecraft",
    "levitate",
    "task-runner"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "workspaceContains:shulker/proj.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shulker-panel",
          "title": "%viewsContainers.shulkerPanel.title%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "shulker-panel": [
        {
          "type": "tree",
          "id": "shulkerPanel.tasks",
          "name": "%views.tasks.name%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "shulkerPanel.tasks",
        "contents": "%viewsWelcome.noProject%",
        "when": "workspaceFolderCount > 0 && !shulkerPanel.isProject && config.shulkerPanel.showNonProjectWarning"
      },
      {
        "view": "shulkerPanel.tasks",
        "contents": "%viewsWelcome.initOnly%",
        "when": "workspaceFolderCount > 0 && !shulkerPanel.isProject && !config.shulkerPanel.showNonProjectWarning"
      },
      {
        "view": "shulkerPanel.tasks",
        "contents": "%viewsWelcome.noFolder%",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "shulkerPanel.initProject",
        "title": "%command.initProject.title%",
        "category": "Shulker",
        "icon": "$(new-folder)"
      },
      {
        "command": "shulkerPanel.refreshTasks",
        "title": "%command.refreshTasks.title%",
        "category": "Shulker",
        "icon": "$(refresh)"
      },
      {
        "command": "shulkerPanel.runTask",
        "title": "%command.runTask.title%",
        "category": "Shulker",
        "icon": "$(play)"
      },
      {
        "command": "shulkerPanel.runCommand",
        "title": "%command.runCommand.title%",
        "category": "Shulker",
        "icon": "$(terminal)"
      },
      {
        "command": "shulkerPanel.openTaskFile",
        "title": "%command.openTaskFile.title%",
        "category": "Shulker",
        "icon": "$(go-to-file)"
      },
      {
        "command": "shulkerPanel.copyCommand",
        "title": "%command.copyCommand.title%",
        "category": "Shulker",
        "icon": "$(copy)"
      },
      {
        "command": "shulkerPanel.runQuickPick",
        "title": "%command.runQuickPick.title%",
        "category": "Shulker",
        "icon": "$(run-all)"
      },
      {
        "command": "shulkerPanel.build",
        "title": "%command.build.title%",
        "category": "Shulker",
        "icon": "$(tools)"
      },
      {
        "command": "shulkerPanel.dev",
        "title": "%command.dev.title%",
        "category": "Shulker",
        "icon": "$(zap)"
      },
      {
        "command": "shulkerPanel.publish",
        "title": "%command.publish.title%",
        "category": "Shulker",
        "icon": "$(package)"
      },
      {
        "command": "shulkerPanel.run",
        "title": "%command.run.title%",
        "category": "Shulker",
        "icon": "$(run-all)"
      },
      {
        "command": "shulkerPanel.projInfo",
        "title": "%command.projInfo.title%",
        "category": "Shulker",
        "icon": "$(info)"
      },
      {
        "command": "shulkerPanel.projChname",
        "title": "%command.projChname.title%",
        "category": "Shulker",
        "icon": "$(edit)"
      },
      {
        "command": "shulkerPanel.projChroot",
        "title": "%command.projChroot.title%",
        "category": "Shulker",
        "icon": "$(folder-opened)"
      },
      {
        "command": "shulkerPanel.projChout",
        "title": "%command.projChout.title%",
        "category": "Shulker",
        "icon": "$(folder)"
      },
      {
        "command": "shulkerPanel.vermShow",
        "title": "%command.vermShow.title%",
        "category": "Shulker",
        "icon": "$(eye)"
      },
      {
        "command": "shulkerPanel.vermSmajor",
        "title": "%command.vermSmajor.title%",
        "category": "Shulker",
        "icon": "$(arrow-up)"
      },
      {
        "command": "shulkerPanel.vermSminor",
        "title": "%command.vermSminor.title%",
        "category": "Shulker",
        "icon": "$(arrow-up)"
      },
      {
        "command": "shulkerPanel.vermSfix",
        "title": "%command.vermSfix.title%",
        "category": "Shulker",
        "icon": "$(arrow-up)"
      },
      {
        "command": "shulkerPanel.vermSet",
        "title": "%command.vermSet.title%",
        "category": "Shulker",
        "icon": "$(edit)"
      },
      {
        "command": "shulkerPanel.envList",
        "title": "%command.envList.title%",
        "category": "Shulker",
        "icon": "$(list-unordered)"
      },
      {
        "command": "shulkerPanel.envGet",
        "title": "%command.envGet.title%",
        "category": "Shulker",
        "icon": "$(search)"
      },
      {
        "command": "shulkerPanel.envSet",
        "title": "%command.envSet.title%",
        "category": "Shulker",
        "icon": "$(edit)"
      },
      {
        "command": "shulkerPanel.envRemove",
        "title": "%command.envRemove.title%",
        "category": "Shulker",
        "icon": "$(trash)"
      },
      {
        "command": "shulkerPanel.mrpSerialize",
        "title": "%command.mrpSerialize.title%",
        "category": "Shulker",
        "icon": "$(sync)"
      },
      {
        "command": "shulkerPanel.mrpRestore",
        "title": "%command.mrpRestore.title%",
        "category": "Shulker",
        "icon": "$(cloud-download)"
      },
      {
        "command": "shulkerPanel.mrpExport",
        "title": "%command.mrpExport.title%",
        "category": "Shulker",
        "icon": "$(export)"
      },
      {
        "command": "shulkerPanel.mrpAdd",
        "title": "%command.mrpAdd.title%",
        "category": "Shulker",
        "icon": "$(add)"
      },
      {
        "command": "shulkerPanel.mrpUpdate",
        "title": "%command.mrpUpdate.title%",
        "category": "Shulker",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "shulkerPanel.mrpLock",
        "title": "%command.mrpLock.title%",
        "category": "Shulker",
        "icon": "$(lock)"
      },
      {
        "command": "shulkerPanel.mrpUnlock",
        "title": "%command.mrpUnlock.title%",
        "category": "Shulker",
        "icon": "$(unlock)"
      },
      {
        "command": "shulkerPanel.mrpClean",
        "title": "%command.mrpClean.title%",
        "category": "Shulker",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "shulkerPanel.refreshTasks",
          "when": "view == shulkerPanel.tasks",
          "group": "navigation"
        },
        {
          "command": "shulkerPanel.runQuickPick",
          "when": "view == shulkerPanel.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "shulkerPanel.runTask",
          "when": "view == shulkerPanel.tasks && viewItem == taskItem",
          "group": "inline"
        },
        {
          "command": "shulkerPanel.openTaskFile",
          "when": "view == shulkerPanel.tasks && viewItem == taskItem",
          "group": "context@1"
        },
        {
          "command": "shulkerPanel.copyCommand",
          "when": "view == shulkerPanel.tasks && viewItem == taskItem",
          "group": "context@2"
        },
        {
          "command": "shulkerPanel.runCommand",
          "when": "view == shulkerPanel.tasks && viewItem == commandItem",
          "group": "inline"
        },
        {
          "command": "shulkerPanel.copyCommand",
          "when": "view == shulkerPanel.tasks && viewItem == commandItem",
          "group": "context@1"
        },
        {
          "command": "shulkerPanel.runCommand",
          "when": "view == shulkerPanel.tasks && viewItem == commandItemWithInput",
          "group": "inline"
        },
        {
          "command": "shulkerPanel.copyCommand",
          "when": "view == shulkerPanel.tasks && viewItem == commandItemWithInput",
          "group": "context@1"
        },
        {
          "command": "shulkerPanel.openTaskFile",
          "when": "view == shulkerPanel.tasks && viewItem == subTaskItem",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "shulkerPanel.runTask",
          "when": "false"
        },
        {
          "command": "shulkerPanel.runCommand",
          "when": "false"
        },
        {
          "command": "shulkerPanel.openTaskFile",
          "when": "false"
        },
        {
          "command": "shulkerPanel.copyCommand",
          "when": "false"
        },
        {
          "command": "shulkerPanel.build",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.dev",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.publish",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.run",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.runQuickPick",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.projInfo",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.projChname",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.projChroot",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.projChout",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.vermShow",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.vermSmajor",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.vermSminor",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.vermSfix",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.vermSet",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.envList",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.envGet",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.envSet",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.envRemove",
          "when": "shulkerPanel.isProject"
        },
        {
          "command": "shulkerPanel.mrpSerialize",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.mrpRestore",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.mrpExport",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.mrpAdd",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.mrpUpdate",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.mrpLock",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.mrpUnlock",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.mrpClean",
          "when": "shulkerPanel.isProject && shulkerPanel.hasModrinth"
        },
        {
          "command": "shulkerPanel.initProject",
          "when": "workspaceFolderCount > 0 && !shulkerPanel.isProject"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "shulkerPanel.srdkPath": {
          "type": "string",
          "default": "",
          "description": "%config.srdkPath.description%"
        },
        "shulkerPanel.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoRefresh.description%"
        },
        "shulkerPanel.showNonProjectWarning": {
          "type": "boolean",
          "default": true,
          "description": "%config.showNonProjectWarning.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun build src/extension.ts --outdir dist --external vscode --target node --format cjs --minify",
    "watch": "bun build src/extension.ts --outdir dist --external vscode --target node --format cjs --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "package": "bun run build && vsce package --no-dependencies",
    "publish": "bun run build && vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
